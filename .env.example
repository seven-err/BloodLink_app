EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Web-only base URL for email confirmation when using Expo web.
# Native / Expo Go ignores this and uses bloodlink:// or exp:// deep links instead.
# Also allow these in Supabase Auth → URL Configuration → Redirect URLs:
#   http://localhost:8081/**
#   bloodlink://**
#   exp://**
# Site URL should be http://localhost:8081 (not :3000).
EXPO_PUBLIC_AUTH_REDIRECT_URL=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org
EXPO_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
EXPO_PUBLIC_OSM_USER_AGENT=BloodLink/1.0 your-email@example.com

# Google sign-in. Android and iOS use the native account picker. The Web client ID is
# required for the ID token. Android also needs a Google Cloud Android OAuth client
# whose SHA-1 matches the keystore that signed the installed APK. Web uses browser OAuth.
# Enable Google in Supabase Auth with the Web client ID and secret.
# Allow redirects: bloodlink://** , exp://** , and your web origin.
# iOS native picker: set ios client ID + reversed client ID as EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME
#   (com.googleusercontent.apps.XXXX). Enable "Skip nonce check" in Supabase Google provider for iOS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# MapLibre street style (OpenFreeMap / OpenStreetMap data — no API key required)
EXPO_PUBLIC_MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Satellite imagery (Esri; OSM has no official satellite layer)
EXPO_PUBLIC_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Backend-only email settings. Do not expose these with EXPO_PUBLIC_.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BloodLink <no-reply@example.com>

# Supabase Auth email is delivered by Brevo custom SMTP in the hosted project.
# Configure these values in Supabase Dashboard > Authentication > Emails > SMTP Settings.
# Never expose the SMTP key through EXPO_PUBLIC_* or commit it to this file.
# Server: smtp-relay.brevo.com, port: 587
# Username: the SMTP login shown by Brevo (not necessarily the account email)
# Password: a Brevo SMTP key (not an API key)

# SMS — Supabase Edge Function secrets only (never EXPO_PUBLIC_*).
# Set via: npx supabase secrets set --project-ref <ref> KEY=value
#
# PhilSMS (https://dashboard.philsms.com/developers/docs) for OTP + opt-in app SMS alerts
PHILSMS_API_TOKEN=
# Alphanumeric sender ID, max 11 characters (must be approved in PhilSMS dashboard)
PHILSMS_SENDER_ID=PhilSMS
# Shared secret for Database Webhook → send-alert-sms (header x-alert-sms-secret)
ALERT_SMS_SECRET=
# Auth Send SMS Hook secret from Supabase Dashboard → Authentication → Hooks → Send SMS
SEND_SMS_HOOK_SECRET=

# Backend-only Hemie AI settings (copy into server/.env, not the Expo client).
# Provider: Groq. Do not expose with EXPO_PUBLIC_. Never commit a real key.
# Paste a key from https://console.groq.com/keys into server/.env HEMIE_LLM_API_KEY.
# POST /api/chat fails closed if HEMIE_LLM_API_KEY is empty.
# Optional: HEMIE_LLM_FALLBACK_MODELS, HEMIE_RATE_LIMIT_MAX, HEMIE_RATE_LIMIT_WINDOW_MS.
# Hemie session checks also need SUPABASE_URL and SUPABASE_ANON_KEY in server/.env.
SUPABASE_URL=
SUPABASE_ANON_KEY=
HEMIE_LLM_API_KEY=
HEMIE_LLM_BASE_URL=https://api.groq.com/openai/v1
HEMIE_LLM_MODEL=openai/gpt-oss-120b
HEMIE_LLM_FALLBACK_MODELS=openai/gpt-oss-20b
HEMIE_RATE_LIMIT_MAX=40
HEMIE_RATE_LIMIT_WINDOW_MS=60000
