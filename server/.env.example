PORT=3001
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
EMAIL_API_KEY=replace-with-a-long-random-server-secret
EMAIL_RATE_LIMIT_MAX=30
EMAIL_RATE_LIMIT_WINDOW_MS=60000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-backend-email@gmail.com
SMTP_PASS=replace-with-your-smtp-app-password
SMTP_FROM="BloodLink <your-backend-email@gmail.com>"

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EXPO_ACCESS_TOKEN=
# Hemie AI (POST /api/chat). Server-only. Never put this in EXPO_PUBLIC_* or commit a real key.
# Provider: Groq OpenAI-compatible chat (https://api.groq.com/openai/v1/chat/completions).
# Create a key at https://console.groq.com/keys and paste it below. Do not use the old "ollama" placeholder.
# If HEMIE_LLM_API_KEY is empty, /api/chat fails closed with a friendly unavailable message.
# Optional: HEMIE_LLM_FALLBACK_MODELS (comma-separated), HEMIE_RATE_LIMIT_MAX, HEMIE_RATE_LIMIT_WINDOW_MS.
# Also required for Hemie auth: SUPABASE_URL and SUPABASE_ANON_KEY (server-only).
HEMIE_LLM_API_KEY=
HEMIE_LLM_BASE_URL=https://api.groq.com/openai/v1
HEMIE_LLM_MODEL=openai/gpt-oss-120b
HEMIE_LLM_FALLBACK_MODELS=openai/gpt-oss-20b
HEMIE_RATE_LIMIT_MAX=40
HEMIE_RATE_LIMIT_WINDOW_MS=60000
